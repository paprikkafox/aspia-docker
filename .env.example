# First-run settings. After the first start everything lives in ./data and this file can be
# emptied - the configs under ./data are the source of truth.

# Image tag to run from ghcr.io/paprikkafox/aspia-docker (an existing release, e.g. 3.0.23
# or "latest").
ASPIA_VERSION=3.0.23

# REQUIRED on the first start: the public address of the Relay, used by Hosts and Clients to
# reach it (public IP or DNS name, or a forwarded port).
ASPIA_RELAY_PEER_PUBLIC_ADDRESS=relay.example.com

# Log level: 0 trace, 1 info, 2 warning, 3 error, 4 fatal.
ASPIA_LOG_LEVEL=1
